# 服务端口
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT 密钥（部署前务必修改）
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=12h

# 密码哈希强度
BCRYPT_ROUNDS=10

# 数据库文件位置（默认 data/exam.db）
# DB_FILE=./data/exam.db

# 限流
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# AI 学习监督接口（默认关闭，仅预留；启用后请求头需要 x-supervisor-key）
SUPERVISOR_ENABLED=false
SUPERVISOR_API_KEY=
SUPERVISOR_NAME=AI 学习助手
